{
  "name": "XML",
  "extensions": ["xml", "html", "xhtml", "svg"],
  "indent": 2,
  "rules": [
    { "kind": "comment", "type": "block", "start": "<!--", "end": "-->" },
    { "kind": "string",  "type": "quote", "quotes": ["\"", "'"] },
    { "kind": "type", "words": [
      "html","head","body","div","span","p","a","img","script","style",
      "meta","link","title","xml","tag","attribute"
    ]}
  ],
  "completions": []
}
