{
  "name": "Swift",
  "extensions": ["swift"],
  "indent": 4,
  "operators": ["=", "==", "!=", "<=", ">=", "&&", "||", "??", "->", "=>",
                "+=", "-=", "*=", "/=", "%=", "..<", "...",
                "+", "-", "*", "/", "%", "<", ">", "!", "?", ":", "&", "|", "^", "~"],
  "punctuation": "()[]{};,.@",
  "brackets": [["{", "}"], ["(", ")"], ["[", "]"]],
  "lineComment": "//",
  "blockComment": ["/*", "*/"],
  "quotes": ["\""],
  "blockQuotes": [],
  "rules": [
    { "kind": "comment", "type": "block", "start": "/*", "end": "*/" },
    { "kind": "comment", "type": "line",  "start": "//" },
    { "kind": "string",  "type": "quote", "quotes": ["\""] },
    { "kind": "number",  "regex": "\\b\\d+(\\.\\d+)?\\b" },
    { "kind": "keyword", "words": [
      "associatedtype","class","deinit","enum","extension","fileprivate",
      "func","import","init","inout","internal","let","open","operator",
      "private","protocol","public","static","struct","subscript","typealias",
      "var","break","case","catch","continue","default","defer","do","else",
      "fallthrough","for","guard","if","in","repeat","return","switch",
      "where","while","as","Any","catch","false","is","nil","rethrows",
      "self","Self","super","throw","throws","true","try","async","await"
    ]},
    { "kind": "type", "words": [
      "Int","Int8","Int16","Int32","Int64","UInt","UInt8","UInt16","UInt32",
      "UInt64","Float","Double","Bool","String","Character","Array",
      "Dictionary","Set","Optional","Result","Error"
    ]},
    { "kind": "library", "words": [
      "print","debugPrint","dump","assert","precondition","fatalError"
    ]}
  ],
  "completions": [
    { "label": "func", "insert": "func () {\n    \n}", "detail": "function" },
    { "label": "guard let", "insert": "guard let x = x else { return }", "detail": "guard" },
    { "label": "if let", "insert": "if let x = x {\n    \n}", "detail": "if-let" }
  ]
}
