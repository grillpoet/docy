{
  "name": "C",
  "extensions": ["c", "h"],
  "indent": 4,
  "operators": ["=", "==", "!=", "<=", ">=", "&&", "||", "++", "--",
                "+=", "-=", "*=", "/=", "%=", "<<=", ">>=", "&=", "|=", "^=",
                "<<", ">>", "->", "+", "-", "*", "/", "%", "<", ">", "!", "?",
                ":", "&", "|", "^", "~"],
  "punctuation": "()[]{};,.@",
  "brackets": [["{", "}"], ["(", ")"], ["[", "]"]],
  "lineComment": "//",
  "blockComment": ["/*", "*/"],
  "quotes": ["\""],
  "blockQuotes": [],
  "rules": [
    { "kind": "comment", "type": "block", "start": "/*", "end": "*/" },
    { "kind": "comment", "type": "line",  "start": "//" },
    { "kind": "string",  "type": "quote", "quotes": ["\""] },
    { "kind": "number",  "regex": "\\b\\d+(\\.\\d+)?[fFuUlL]?\\b" },
    { "kind": "keyword", "words": [
      "auto","break","case","const","continue","default","do","else","enum",
      "extern","for","goto","if","inline","register","restrict","return",
      "sizeof","static","struct","switch","typedef","union","volatile","while",
      "NULL"
    ]},
    { "kind": "type", "words": [
      "char","double","float","int","long","short","signed","unsigned","void",
      "_Bool","size_t","ssize_t","int8_t","int16_t","int32_t","int64_t",
      "uint8_t","uint16_t","uint32_t","uint64_t","FILE","bool"
    ]},
    { "kind": "library", "words": [
      "printf","scanf","fprintf","fscanf","sprintf","snprintf",
      "malloc","calloc","realloc","free","memcpy","memset","memmove",
      "strlen","strcmp","strncmp","strcpy","strncpy","strcat","strstr",
      "fopen","fclose","fread","fwrite","fgets","fputs",
      "exit","abort","atoi","atof","rand","srand"
    ]}
  ],
  "completions": [
    { "label": "int main", "insert": "int main(int argc, char *argv[]) {\n    \n    return 0;\n}", "detail": "main" },
    { "label": "printf", "insert": "printf(\"\\n\");", "detail": "printf" },
    { "label": "for", "insert": "for (int i = 0; i < n; i++) {\n    \n}", "detail": "for" }
  ]
}
