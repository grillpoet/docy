{
  "name": "Lisp",
  "extensions": [
    "lisp",
    "cl",
    "el",
    "lsp",
    "asd"
  ],
  "indent": 2,
  "operators": [
    "=",
    "/=",
    "<",
    ">",
    "<=",
    ">=",
    "+",
    "-",
    "*",
    "/",
    "mod",
    "rem"
  ],
  "punctuation": "()[],'`;",
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "lineComment": ";",
  "blockComment": [
    "#|",
    "|#"
  ],
  "quotes": [
    "\""
  ],
  "blockQuotes": [],
  "rules": [
    {
      "kind": "comment",
      "type": "block",
      "start": "#|",
      "end": "|#"
    },
    {
      "kind": "comment",
      "type": "line",
      "start": ";"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\""
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "defun",
        "defmacro",
        "defvar",
        "defparameter",
        "defconstant",
        "defstruct",
        "defclass",
        "defmethod",
        "defgeneric",
        "defpackage",
        "in-package",
        "lambda",
        "let",
        "let*",
        "flet",
        "labels",
        "if",
        "when",
        "unless",
        "cond",
        "case",
        "ecase",
        "typecase",
        "loop",
        "do",
        "dolist",
        "dotimes",
        "block",
        "return-from",
        "return",
        "catch",
        "throw",
        "unwind-protect",
        "handler-case",
        "handler-bind",
        "funcall",
        "apply",
        "quote",
        "function",
        "setq",
        "setf",
        "psetq",
        "psetf",
        "and",
        "or",
        "not",
        "nil",
        "t"
      ]
    },
    {
      "kind": "type",
      "words": [
        "integer",
        "float",
        "string",
        "symbol",
        "list",
        "cons",
        "array",
        "vector",
        "hash-table",
        "character",
        "number",
        "function",
        "t",
        "nil"
      ]
    },
    {
      "kind": "library",
      "words": [
        "format",
        "print",
        "princ",
        "prin1",
        "terpri",
        "read",
        "read-line",
        "car",
        "cdr",
        "caar",
        "cadr",
        "cddr",
        "cons",
        "list",
        "append",
        "reverse",
        "length",
        "nth",
        "first",
        "second",
        "third",
        "rest",
        "last",
        "mapcar",
        "mapc",
        "maplist",
        "reduce",
        "remove",
        "find",
        "position",
        "sort",
        "member",
        "assoc",
        "push",
        "pop",
        "add",
        "remove"
      ]
    }
  ],
  "completions": [
    {
      "label": "defun",
      "insert": "(defun name (args)\n  )",
      "detail": "defun"
    },
    {
      "label": "defvar",
      "insert": "(defvar *name* value)",
      "detail": "defvar"
    },
    {
      "label": "let",
      "insert": "(let ((x value))\n  )",
      "detail": "let"
    },
    {
      "label": "format",
      "insert": "(format t \"~a~%\" )",
      "detail": "format"
    },
