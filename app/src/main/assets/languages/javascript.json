{
  "name": "JavaScript",
  "extensions": [
    "js",
    "mjs",
    "cjs",
    "jsx"
  ],
  "indent": 2,
  "operators": [
    "===",
    "!==",
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "??",
    "?.",
    "=>",
    "++",
    "--",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "<<=",
    ">>=",
    "<<",
    ">>",
    "+",
    "-",
    "*",
    "/",
    "%",
    "<",
    ">",
    "!",
    "?",
    ":",
    "&",
    "|",
    "^",
    "~",
    "="
  ],
  "punctuation": "()[]{};,.@#",
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "lineComment": "//",
  "blockComment": [
    "/*",
    "*/"
  ],
  "quotes": [
    "\"",
    "'",
    "`"
  ],
  "blockQuotes": [],
  "rules": [
    {
      "kind": "comment",
      "type": "block",
      "start": "/*",
      "end": "*/"
    },
    {
      "kind": "comment",
      "type": "line",
      "start": "//"
    },
    {
      "kind": "string",
      "type": "block",
      "start": "`",
      "end": "`"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\"",
        "'"
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "break",
        "case",
        "catch",
        "class",
        "const",
        "continue",
        "debugger",
        "default",
        "delete",
        "do",
        "else",
        "export",
        "extends",
        "finally",
        "for",
        "function",
        "if",
        "import",
        "in",
        "instanceof",
        "let",
        "new",
        "of",
        "return",
        "static",
        "super",
        "switch",
        "this",
        "throw",
        "try",
        "typeof",
        "var",
        "void",
        "while",
        "with",
        "yield",
        "async",
        "await",
        "true",
        "false",
        "null",
        "undefined",
        "NaN",
        "Infinity",
        "globalThis"
      ]
    },
    {
      "kind": "type",
      "words": [
        "Array",
        "ArrayBuffer",
        "BigInt",
        "Boolean",
        "DataView",
        "Date",
        "Error",
        "EvalError",
        "Float32Array",
        "Float64Array",
        "Function",
        "Int8Array",
        "Int16Array",
        "Int32Array",
        "JSON",
        "Map",
        "Math",
        "Number",
        "Object",
        "Promise",
        "Proxy",
        "RangeError",
        "ReferenceError",
        "RegExp",
        "Set",
        "String",
        "Symbol",
        "SyntaxError",
        "TypeError",
        "URIError",
        "Uint8Array",
        "Uint16Array",
        "Uint32Array",
        "WeakMap",
        "WeakSet",
        "Intl",
        "Reflect"
      ]
    },
    {
      "kind": "library",
      "words": [
        "console.log",
        "console.error",
        "console.warn",
        "console.info",
        "console.debug",
        "document.getElementById",
        "document.querySelector",
        "document.querySelectorAll",
        "document.createElement",
        "document.write",
        "window.alert",
        "window.confirm",
        "window.prompt",
        "window.setTimeout",
        "window.setInterval",
        "window.clearTimeout",
        "window.clearInterval",
        "window.fetch",
        "JSON.parse",
        "JSON.stringify",
        "Object.keys",
        "Object.values",
        "Object.entries",
        "Object.assign",
        "Array.isArray",
        "Array.from",
        "Array.of",
        "parseInt",
        "parseFloat",
        "isNaN",
        "isFinite",
        "encodeURIComponent",
        "decodeURIComponent",
        "localStorage.getItem",
        "localStorage.setItem",
        "sessionStorage.getItem",
        "sessionStorage.setItem",
        "Math.abs",
        "Math.max",
        "Math.min",
        "Math.random",
        "Math.floor",
        "Math.ceil",
        "Math.round",
        "Math.PI"
      ]
    }
  ],
  "completions": [
    {
      "label": "function",
      "insert": "function () {\n  \n}",
      "detail": "function"
    },
    {
      "label": "const",
      "insert": "const  = ",
      "detail": "constant"
    },
    {
      "label": "let",
      "insert": "let  = ",
      "detail": "let"
    },
    {
      "label": "arrow",
      "insert": "() => {\n  \n}",
      "detail": "arrow function"
    },
    {
      "label": "if",
      "insert": "if () {\n  \n}",
      "detail": "if"
    },
    {
      "label": "for",
      "insert": "for (let i = 0; i < n; i++) {\n  \n}",
      "detail": "for loop"
    },
    {
      "label": "for-of",
      "insert": "for (const item of collection) {\n  \n}",
      "detail": "for-of"
    },
    {
      "label": "try",
      "insert": "try {\n  \n} catch (e) {\n  console.error(e);\n}",
      "detail": "try-catch"
    },
