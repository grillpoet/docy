    {
      "kind": "library",
      "words": [
        "print",
        "debugPrint",
        "dump",
        "assert",
        "precondition",
        "fatalError",
        "min",
        "max",
        "abs",
        "sqrt",
        "pow",
        "floor",
        "ceil",
        "round",
        "String(format:)",
