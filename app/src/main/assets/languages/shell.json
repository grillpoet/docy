  "completions": [
    {
      "label": "#!/bin/bash",
      "insert": "#!/bin/bash\nset -euo pipefail\n\n",
      "detail": "shebang"
    },
    {
      "label": "if",
      "insert": "if [ ]; then\n  \nfi",
      "detail": "if"
    },
    {
      "label": "for",
      "insert": "for x in \"$@\"; do\n  \ndone",
      "detail": "for"
    },
    {
      "label": "while",
      "insert": "while [ ]; do\n  \ndone",
      "detail": "while"
    },
    {
      "label": "function",
      "insert": "function name() {\n  \n}",
      "detail": "function"
    },
    {
      "label": "case",
      "insert": "case $1 in\n  start)\n    ;;\n  stop)\n    ;;\n  *)\n    ;;\nesac",
      "detail": "case"
    },
