      "detail": "struct"
    },
    {
      "label": "enum",
      "insert": "enum  {\n    ,\n}",
      "detail": "enum"
    },
    {
      "label": "for",
      "insert": "for item in collection {\n    \n}",
      "detail": "for loop"
