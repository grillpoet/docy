      "end": "*/"
    },
    {
      "kind": "comment",
      "type": "line",
      "start": "//"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\""
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?[fFlLdD]?\\b"
    },
    {
