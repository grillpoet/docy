{
  "name": "Tcl",
  "extensions": [
    "tcl",
    "tk"
  ],
  "indent": 4,
  "operators": [
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "+",
    "-",
    "*",
    "/",
    "%",
    "<",
    ">",
    "!",
    "="
  ],
  "punctuation": "(){}[];,",
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "lineComment": "#",
  "blockComment": [],
  "quotes": [
    "\""
  ],
  "blockQuotes": [],
  "rules": [
    {
      "kind": "comment",
      "type": "line",
      "start": "#"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\""
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "if",
        "then",
        "else",
        "elseif",
        "switch",
        "case",
        "default",
        "while",
        "for",
        "foreach",
        "break",
        "continue",
        "return",
        "proc",
        "set",
        "unset",
        "global",
        "variable",
        "upvar",
        "namespace",
        "eval",
        "expr",
        "list",
        "lindex",
        "llength",
        "lappend",
        "linsert",
        "lreplace",
        "lrange",
        "lsearch",
        "lsort",
        "lset",
        "dict",
        "array",
        "string",
        "format",
        "scan",
        "regexp",
        "regsub",
        "catch",
        "error",
        "exec",
        "open",
        "close",
        "read",
        "puts",
        "gets",
        "file",
        "source",
        "incr",
        "append",
        "join",
        "split",
        "subst",
        "uplevel",
        "info",
        "exit"
      ]
    },
    {
      "kind": "type",
      "words": []
    },
    {
      "kind": "library",
      "words": [
        "tk",
        "Tk",
        "button",
        "label",
        "entry",
        "text",
        "frame",
        "pack",
        "grid",
        "place",
        "bind",
        "canvas",
        "menu",
        "message",
        "scrollbar",
        "toplevel"
      ]
    }
  ],
  "completions": [
    {
      "label": "proc",
      "insert": "proc name {args} {\n    \n}",
      "detail": "proc"
    },
    {
      "label": "set",
      "insert": "set var value",
      "detail": "set"
    },
    {
      "label": "if",
      "insert": "if {condition} {\n    \n}",
      "detail": "if"
    },
    {
      "label": "foreach",
