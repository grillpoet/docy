{
  "name": "Go",
  "extensions": [
    "go"
  ],
  "indent": 4,
  "operators": [
    "=",
    ":=",
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "<-",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "&=",
    "|=",
    "^=",
    "<<=",
    ">>=",
    "+",
    "-",
    "*",
    "/",
    "%",
    "<",
    ">",
    "!",
    "&",
    "|",
    "^",
    "<<"
  ],
  "punctuation": "()[]{};,.@",
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "lineComment": "//",
  "blockComment": [
    "/*",
    "*/"
  ],
  "quotes": [
    "\"",
    "`"
  ],
  "blockQuotes": [],
  "rules": [
    {
      "kind": "comment",
      "type": "block",
      "start": "/*",
      "end": "*/"
    },
    {
      "kind": "comment",
      "type": "line",
      "start": "//"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\"",
        "`"
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "break",
        "case",
        "chan",
        "const",
        "continue",
        "default",
        "defer",
        "else",
        "fallthrough",
        "for",
        "func",
        "go",
        "goto",
        "if",
        "import",
        "interface",
        "map",
        "package",
        "range",
        "return",
        "select",
        "struct",
        "switch",
        "type",
        "var",
        "true",
        "false",
        "nil",
        "iota"
      ]
    },
    {
      "kind": "type",
      "words": [
        "bool",
        "byte",
        "complex64",
        "complex128",
        "error",
        "float32",
        "float64",
        "int",
        "int8",
        "int16",
        "int32",
        "int64",
        "rune",
        "string",
        "uint",
        "uint8",
        "uint16",
        "uint32",
        "uint64",
        "uintptr",
        "any",
        "sync.Mutex",
        "sync.RWMutex",
        "sync.WaitGroup",
        "sync.Once",
        "context.Context",
        "time.Time",
        "time.Duration",
        "bytes.Buffer",
        "strings.Builder",
        "bufio.Scanner",
        "bufio.Reader",
        "bufio.Writer",
        "io.Reader",
        "io.Writer",
        "http.Client",
        "http.Request",
        "http.Response",
        "json.Decoder",
        "json.Encoder",
        "os.File",
        "filepath.WalkFunc"
      ]
    },
    {
      "kind": "library",
      "words": [
        "fmt.Println",
        "fmt.Printf",
        "fmt.Sprintf",
        "fmt.Errorf",
        "fmt.Sprint",
        "fmt.Sprintln",
        "fmt.Fprintf",
        "fmt.Scan",
        "fmt.Scanf",
        "make",
        "new",
        "len",
        "cap",
        "append",
        "copy",
        "delete",
        "panic",
        "recover",
        "close",
        "println",
        "print",
        "complex",
        "real",
        "imag",
        "os.Exit",
        "os.Args",
        "os.Getenv",
        "os.Setenv",
        "os.Open",
        "os.Create",
        "os.ReadFile",
        "os.WriteFile",
        "os.Mkdir",
        "os.MkdirAll",
        "os.Remove",
        "os.RemoveAll",
        "os.Stat",
        "os.Rename",
        "os.Chdir",
        "os.Getwd",
        "log.Println",
        "log.Printf",
        "log.Fatal",
        "log.Fatalf",
        "log.New",
        "strings.Split",
        "strings.Join",
        "strings.TrimSpace",
        "strings.Trim",
        "strings.HasPrefix",
        "strings.HasSuffix",
        "strings.Contains",
        "strings.Replace",
        "strings.ToLower",
        "strings.ToUpper",
        "strings.Fields",
        "strings.Repeat",
        "strconv.Itoa",
        "strconv.Atoi",
        "strconv.FormatInt",
        "strconv.ParseInt",
        "time.Now",
        "time.Sleep",
        "time.Since",
        "time.Parse",
        "time.Duration",
        "json.Marshal",
        "json.Unmarshal",
        "json.NewDecoder",
        "json.NewEncoder"
      ]
    }
  ],
  "completions": [
    {
      "label": "func main",
      "insert": "func main() {\n    \n}",
      "detail": "main"
    },
    {
      "label": "fmt.Println",
      "insert": "fmt.Println()",
      "detail": "Println"
    },
    {
      "label": "if err != nil",
      "insert": "if err != nil {\n    return err\n}",
      "detail": "err check"
    },
    {
      "label": "for",
      "insert": "for i := 0; i < n; i++ {\n    \n}",
      "detail": "for loop"
    },
    {
      "label": "for-range",
      "insert": "for i, v := range items {\n    \n}",
      "detail": "for-range"
    },
    {
