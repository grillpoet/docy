{
  "name": "Wren",
  "extensions": [
    "wren"
  ],
  "indent": 2,
  "operators": [
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "..",
    "...",
    "+",
    "-",
    "*",
    "/",
    "%",
    "<",
    ">",
    "!",
    "?",
    ":",
    "="
  ],
  "punctuation": "()[]{};,.@",
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "lineComment": "//",
  "blockComment": [
    "/*",
    "*/"
  ],
  "quotes": [
    "\""
  ],
  "blockQuotes": [],
  "rules": [
    {
      "kind": "comment",
      "type": "block",
      "start": "/*",
      "end": "*/"
    },
    {
      "kind": "comment",
      "type": "line",
      "start": "//"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\""
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "break",
        "class",
        "construct",
        "continue",
        "else",
        "false",
        "for",
        "foreign",
        "if",
        "import",
        "in",
        "is",
        "null",
        "return",
        "static",
        "super",
        "this",
        "true",
        "var",
        "while",
        "as",
        "abstract",
        "final",
        "get",
        "set",
        "new"
      ]
    },
    {
      "kind": "type",
      "words": [
        "Bool",
        "Class",
        "Fiber",
        "Fn",
        "List",
        "Map",
        "Null",
        "Num",
        "Object",
        "Range",
        "Sequence",
        "String",
        "System"
      ]
    },
    {
      "kind": "library",
      "words": [
        "System",
        "Fiber",
        "write",
        "print",
        "clock",
        "gc"
      ]
    }
  ],
  "completions": [
    {
      "label": "class",
      "insert": "class  {\n  construct new() {\n    \n  }\n}",
      "detail": "class"
    },
    {
      "label": "var",
      "insert": "var  = ",
      "detail": "var"
    },
    {
      "label": "System.print",
      "insert": "System.print()",
      "detail": "print"
    },
    {
      "label": "break",
      "insert": "break",
      "detail": "keyword"
    },
    {
      "label": "construct",
      "insert": "construct",
      "detail": "keyword"
    },
    {
      "label": "continue",
      "insert": "continue",
      "detail": "keyword"
    },
    {
      "label": "else",
      "insert": "else",
      "detail": "keyword"
    },
    {
      "label": "false",
      "insert": "false",
      "detail": "keyword"
    },
    {
