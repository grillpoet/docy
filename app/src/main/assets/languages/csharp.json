{
  "name": "C#",
  "extensions": [
    "cs"
  ],
  "indent": 4,
  "operators": [
    "=",
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "++",
    "--",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "??",
    "?.",
    "=>",
    "+",
    "-",
    "*",
    "/",
    "%",
    "<",
    ">",
    "!",
    "?",
    ":",
    "&",
    "|",
    "^",
    "~"
  ],
  "punctuation": "()[]{};,.@",
