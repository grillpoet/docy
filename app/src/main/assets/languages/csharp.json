    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "lineComment": "//",
  "blockComment": [
    "/*",
    "*/"
  ],
  "quotes": [
    "\""
  ],
  "blockQuotes": [],
  "rules": [
    {
      "kind": "comment",
      "type": "block",
      "start": "/*",
      "end": "*/"
    },
    {
      "kind": "comment",
      "type": "line",
      "start": "//"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\""
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?[fFdDmMlLuU]?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "abstract",
        "as",
        "async",
        "await",
        "base",
        "break",
        "case",
