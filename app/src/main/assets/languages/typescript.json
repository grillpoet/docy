{
  "name": "TypeScript",
  "extensions": [
    "ts",
    "tsx",
    "mts",
    "cts"
  ],
  "indent": 2,
  "operators": [
    "===",
    "!==",
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||",
    "??",
    "?.",
    "=>",
    "++",
    "--",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "<<=",
    ">>=",
    "<<",
    ">>",
    "+",
    "-",
    "*",
    "/",
    "%",
    "<",
    ">",
    "!",
    "?",
    ":",
    "&",
    "|",
    "^",
    "~",
    "="
  ],
  "punctuation": "()[]{};,.@#",
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "lineComment": "//",
  "blockComment": [
    "/*",
    "*/"
  ],
  "quotes": [
    "\"",
    "'",
    "`"
  ],
  "blockQuotes": [],
  "rules": [
    {
      "kind": "comment",
      "type": "block",
      "start": "/*",
      "end": "*/"
    },
    {
      "kind": "comment",
      "type": "line",
      "start": "//"
    },
    {
      "kind": "string",
      "type": "block",
      "start": "`",
      "end": "`"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\"",
        "'"
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "abstract",
        "any",
        "as",
        "asserts",
        "async",
        "await",
        "bigint",
        "boolean",
        "break",
        "case",
        "catch",
        "class",
        "const",
        "constructor",
        "continue",
        "debugger",
        "declare",
        "default",
        "delete",
        "do",
        "else",
        "enum",
        "export",
        "extends",
        "false",
        "finally",
        "for",
        "from",
        "function",
        "get",
        "if",
        "implements",
        "import",
        "in",
        "infer",
        "instanceof",
        "interface",
        "is",
        "keyof",
        "let",
        "module",
        "namespace",
        "never",
        "new",
        "null",
        "number",
        "object",
        "of",
        "override",
        "package",
        "private",
        "protected",
        "public",
        "readonly",
        "require",
        "return",
        "satisfies",
        "set",
        "static",
        "string",
        "super",
        "switch",
        "symbol",
        "this",
        "throw",
        "true",
        "try",
        "type",
        "typeof",
        "undefined",
        "unique",
        "unknown",
        "var",
        "void",
        "while",
        "with",
        "yield"
      ]
    },
    {
      "kind": "type",
      "words": [
        "Array",
        "Boolean",
        "Date",
        "Error",
        "Map",
        "Number",
        "Object",
        "Promise",
        "RegExp",
        "Set",
        "String",
        "Symbol",
        "WeakMap",
        "WeakSet",
        "Record",
        "Partial",
        "Required",
        "Readonly",
        "Pick",
        "Omit",
        "Exclude",
        "Extract",
        "NonNullable",
        "Parameters",
        "ReturnType",
        "Awaited",
        "InstanceType",
        "ThisType",
        "Uppercase",
        "Lowercase",
        "Capitalize",
        "Uncapitalize"
      ]
    },
    {
      "kind": "library",
      "words": [
        "console.log",
        "console.error",
        "console.warn",
        "document.getElementById",
        "document.querySelector",
        "window.alert",
        "window.fetch",
        "JSON.parse",
        "JSON.stringify",
        "Object.keys",
        "Object.values",
        "Object.entries",
        "Array.isArray",
        "Promise.all",
        "Promise.resolve",
        "Promise.reject",
        "localStorage.getItem",
        "localStorage.setItem",
        "process.env"
      ]
    }
  ],
  "completions": [
    {
      "label": "interface",
      "insert": "interface  {\n  \n}",
      "detail": "interface"
    },
    {
      "label": "type",
      "insert": "type  = ",
      "detail": "type alias"
    },
    {
      "label": "function",
      "insert": "function (): void {\n  \n}",
      "detail": "function"
    },
    {
      "label": "const",
      "insert": "const : = ",
      "detail": "const"
    },
    {
      "label": "enum",
      "insert": "enum  {\n  ,\n}",
      "detail": "enum"
    },
    {
      "label": "class",
      "insert": "class  {\n  constructor() {\n    \n  }\n}",
      "detail": "class"
    },
    {
      "label": "async function",
      "insert": "async function (): Promise<void> {\n  \n}",
      "detail": "async function"
    },
