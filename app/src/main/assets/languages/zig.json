{
  "name": "Zig",
  "extensions": [
    "zig"
  ],
  "indent": 4,
  "operators": [
    "==",
    "!=",
    "<=",
    ">=",
    "<<",
    ">>",
    "<<=",
    ">>=",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "&=",
    "|=",
    "^=",
    "++",
    "**",
    "->",
    "=>",
    "..",
    ".*",
    ".?",
    "+",
    "-",
    "*",
    "/",
    "%",
    "<",
    ">",
    "!",
    "?",
    ":",
    "&",
    "|",
    "^",
    "~",
    "="
  ],
  "punctuation": "()[]{};,.@#",
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "lineComment": "//",
  "blockComment": [],
  "quotes": [
    "\""
  ],
  "blockQuotes": [],
  "rules": [
    {
      "kind": "comment",
      "type": "line",
      "start": "//"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\""
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "const",
        "var",
        "fn",
        "pub",
        "return",
        "if",
        "else",
        "while",
        "for",
        "switch",
        "break",
        "continue",
        "defer",
        "errdefer",
        "try",
        "catch",
        "comptime",
        "inline",
        "export",
        "extern",
        "packed",
        "align",
        "asm",
        "test",
        "suspend",
        "resume",
        "await",
        "async",
        "noinline",
        "threadlocal",
        "usingnamespace",
        "union",
        "enum",
        "struct",
        "error",
        "opaque",
        "orelse",
        "and",
        "or",
        "unreachable",
        "undefined",
        "null",
        "true",
        "false"
      ]
    },
    {
      "kind": "type",
      "words": [
        "i8",
        "i16",
        "i32",
        "i64",
        "i128",
        "u8",
        "u16",
        "u32",
        "u64",
        "u128",
        "usize",
        "isize",
        "f16",
        "f32",
        "f64",
        "f128",
        "bool",
        "void",
        "noreturn",
        "type",
        "anyerror",
        "anytype",
        "anyopaque",
        "comptime_int",
        "comptime_float"
      ]
    },
    {
      "kind": "library",
      "words": [
        "std",
        "debug",
        "print",
        "expect",
        "assert",
        "panic",
        "unreachable"
      ]
    }
  ],
  "completions": [
    {
      "label": "const std",
      "insert": "const std = @import(\"std\");",
      "detail": "import std"
    },
    {
      "label": "pub fn main",
      "insert": "pub fn main() !void {\n    \n}",
      "detail": "main"
    },
    {
      "label": "std.debug.print",
      "insert": "std.debug.print(\"{}\\n\", .{});",
      "detail": "print"
    },
    {
      "label": "try",
      "insert": "try ",
      "detail": "try"
    },
    {
      "label": "const",
      "insert": "const",
      "detail": "keyword"
