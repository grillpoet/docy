{
  "name": "Lua",
  "extensions": [
    "lua"
  ],
  "indent": 2,
  "operators": [
    "==",
    "~=",
    "<=",
    ">=",
    "..",
    "...",
    "+",
    "-",
    "*",
    "/",
    "%",
    "^",
    "#",
    "<",
    ">",
    "=",
    "and",
    "or",
    "not"
  ],
  "punctuation": "()[]{};,.@:",
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "lineComment": "--",
  "blockComment": [
    "--[[",
    "]]"
  ],
  "quotes": [
    "\"",
    "'"
  ],
  "blockQuotes": [
    [
      "[[",
      "]]"
    ]
  ],
  "rules": [
    {
      "kind": "comment",
      "type": "block",
      "start": "--[[",
      "end": "]]"
    },
    {
      "kind": "comment",
      "type": "line",
      "start": "--"
    },
    {
      "kind": "string",
      "type": "block",
      "start": "[[",
      "end": "]]"
    },
    {
      "kind": "string",
      "type": "quote",
      "quotes": [
        "\"",
        "'"
      ]
    },
    {
      "kind": "number",
      "regex": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "kind": "keyword",
      "words": [
        "and",
        "break",
        "do",
        "else",
        "elseif",
        "end",
        "false",
        "for",
        "function",
        "goto",
        "if",
        "in",
        "local",
        "nil",
        "not",
        "or",
        "repeat",
        "return",
        "then",
        "true",
        "until",
        "while"
      ]
    },
    {
      "kind": "library",
      "words": [
        "print",
        "pairs",
        "ipairs",
        "require",
        "type",
        "tostring",
        "tonumber",
        "pcall",
        "xpcall",
        "error",
        "assert",
        "select",
        "setmetatable",
        "getmetatable",
        "rawget",
        "rawset",
        "next",
        "unpack",
        "_G",
        "_ENV",
        "string",
        "table",
        "math",
        "io",
        "os",
        "coroutine",
        "debug"
      ]
    }
  ],
  "completions": [
    {
      "label": "function",
      "insert": "function ()\n  \nend",
      "detail": "function"
    },
    {
      "label": "local",
      "insert": "local  = ",
      "detail": "local"
    },
    {
      "label": "if",
      "insert": "if  then\n  \nend",
      "detail": "if"
    },
    {
      "label": "for",
      "insert": "for i = 1, n do\n  \nend",
      "detail": "for"
    },
    {
      "label": "and",
      "insert": "and",
      "detail": "keyword"
    },
    {
      "label": "break",
      "insert": "break",
      "detail": "keyword"
    },
    {
