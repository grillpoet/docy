  "completions": [
    {
      "label": "def",
      "insert": "def ():\n    ",
      "detail": "function"
    },
    {
      "label": "class",
      "insert": "class :\n    def __init__(self):\n        ",
      "detail": "class"
    },
    {
      "label": "if",
      "insert": "if :\n    ",
      "detail": "if"
    },
    {
      "label": "for",
      "insert": "for item in collection:\n    ",
      "detail": "for loop"
    },
    {
      "label": "while",
      "insert": "while condition:\n    ",
      "detail": "while loop"
    },
    {
      "label": "try",
      "insert": "try:\n    \nexcept Exception as e:\n    print(e)",
      "detail": "try-except"
    },
    {
      "label": "with",
      "insert": "with open('') as f:\n    ",
      "detail": "with"
    },
    {
      "label": "main",
      "insert": "if __name__ == \"__main__\":\n    ",
      "detail": "main guard"
